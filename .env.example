# DevGenius V12 - Variáveis de ambiente

# GEMINI_API_KEY: chave da API Gemini (obrigatória para o chat IA e geração de esquemáticos).
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# PORT: porta do servidor Express.
# Na Hostinger, NÃO defina manualmente — o painel Node.js injeta automaticamente.
# Em desenvolvimento local, deixe vazio (padrão 3000).
PORT=

# NODE_ENV: deixe "production" em servidor.
# Em dev local, deixe vazio para usar Vite em middleware mode.
NODE_ENV=
